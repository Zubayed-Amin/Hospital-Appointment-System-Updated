<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" stylesheets="@Style.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hospitalappointmentsystem.AdminDashboardController">
    <children>
        <Label layoutX="224.0" layoutY="15.0" styleClass="main-title" text="Admin Dashboard" />
        
        <TableView fx:id="userTable" layoutX="26.0" layoutY="70.0" prefHeight="300.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="colID" prefWidth="35.33334159851074" text="ID" />
                <TableColumn fx:id="colFullname" prefWidth="135.3333396911621" text="Fullname" />
            <TableColumn fx:id="colUsername" prefWidth="108.00001525878906" text="Username" />
            <TableColumn fx:id="colPass" prefWidth="102.66668701171875" text="Password" />
                <TableColumn fx:id="colRole" prefWidth="92.0" text="Role" />
            <TableColumn fx:id="colContact" prefWidth="116.66659545898438" text="Contact" />
            </columns>
        </TableView>

        <Button fx:id="addBtn" layoutX="42.0" layoutY="390.0" onAction="#AddUser" styleClass="signup-button" text="Add User" />
        <Button fx:id="editBtn" layoutX="149.0" layoutY="390.0" onAction="#EditUser" styleClass="signup-button" text="Edit User" />
        <Button fx:id="deleteBtn" layoutX="253.0" layoutY="390.0" onAction="#DeleteUser" styleClass="signup-button" text="Delete User" />
        <Button fx:id="logoutBtn" layoutX="527.0" layoutY="390.0" onAction="#Logout" styleClass="signup-button" text="Logout" />
      <Button fx:id="viewAppointBtn" layoutX="373.0" layoutY="390.0" onAction="#ViewApointment" styleClass="signup-button" text="View Apointment" />
    </children>
</AnchorPane>
