<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500" prefWidth="900" stylesheets="@Style.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hospitalappointmentsystem.LaunchPageController">
   <left>
      <VBox fx:id="leftPane" alignment="CENTER" prefWidth="450" spacing="15.0" styleClass="glass-background">
         <VBox.margin>
            <Insets bottom="40" left="50" right="50" top="40" />
         </VBox.margin>
         <children>
            <ImageView fx:id="logoImage" fitHeight="150.0" fitWidth="150.0" preserveRatio="true" styleClass="hover-image">
               <image>
                  <Image url="@../image/DocSetGo%20Logo.png" />
               </image>
            </ImageView>
            <Label styleClass="main-title" text="Welcome" />
            <Button fx:id="guestBtn" onAction="#Guest" styleClass="signup-button" text="use as Guest" />
            <Label fx:id="lblError" alignment="CENTER" contentDisplay="CENTER" prefHeight="20.0" prefWidth="485.0" styleClass="subtitle" text="----------or----------" />
            <Button fx:id="loginBtn" onAction="#Login" styleClass="signup-button" text="Sign In" />
            <HBox alignment="CENTER" spacing="5">
               <children>
                  <Label styleClass="subtitle" text="Don't have an account?" />
                  <Hyperlink fx:id="SignupLink" onAction="#goToSignup" text="Sign up">
                     <styleClass>
                        <String fx:value="footer-link" />
                        <String fx:value="hover-image" />
                     </styleClass>
                  </Hyperlink>
               </children>
            </HBox>
         </children>
      </VBox>
   </left>
   <right>
      <VBox alignment="CENTER" prefWidth="450" spacing="20" styleClass="right-pane-background">
         <children>
            <ImageView fx:id="logoImage1" fitHeight="250.0" fitWidth="250.0" layoutX="181.0" layoutY="185.0" preserveRatio="true" styleClass="hover-image">
               <image>
                  <Image url="@../image/DocSetGo%20Logo.png" />
               </image>
            </ImageView>
         </children>
      </VBox>
   </right>
</BorderPane>
