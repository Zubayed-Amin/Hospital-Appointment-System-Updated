<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="450.0" stylesheets="@Style.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hospitalappointmentsystem.GuestAppointmentController">
   <children>
      <VBox alignment="CENTER" prefHeight="650.0" prefWidth="450.0" spacing="15.0" styleClass="glass-background">
         <children>
            <ImageView fx:id="logoImage" fitHeight="80.0" fitWidth="80.0" preserveRatio="true" styleClass="hover-image">
               <image>
                  <Image url="@../image/DocSetGo%20Logo.png" />
               </image>
            </ImageView>
            <Label alignment="CENTER" prefHeight="35.0" prefWidth="321.0" styleClass="main-title" text="My Appointment" />
            <HBox alignment="CENTER_LEFT" prefHeight="28.0" prefWidth="430.0" spacing="10.0">
               <children>
                  <Label styleClass="view-input" text="Patient Name:" />
                  <Label fx:id="Pname" prefHeight="20.0" prefWidth="265.0" styleClass="view-label">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin></Label>
               </children>
               <padding>
                  <Insets left="62.0" />
               </padding>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="28.0" prefWidth="430.0" spacing="10.0">
               <children>
                  <Label styleClass="view-input" text="Patient Number:" />
                  <Label fx:id="Pnum" prefHeight="20.0" prefWidth="265.0" styleClass="view-label">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin></Label>
               </children>
               <padding>
                  <Insets left="48.0" />
               </padding>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="28.0" prefWidth="430.0" spacing="10.0">
               <children>
                  <Label styleClass="view-input" text="Doctor Name:" />
                  <Label fx:id="Dname" prefHeight="20.0" prefWidth="265.0" styleClass="view-label">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin></Label>
               </children>
               <padding>
                  <Insets left="62.0" />
               </padding>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="28.0" prefWidth="430.0" spacing="10.0">
               <children>
                  <Label styleClass="view-input" text="Doctor Number:" />
                  <Label fx:id="Dnum" prefHeight="20.0" prefWidth="261.0" styleClass="view-label">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin></Label>
               </children>
               <padding>
                  <Insets left="48.0" />
               </padding>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="28.0" prefWidth="430.0" spacing="10.0">
               <children>
                  <Label prefHeight="20.0" prefWidth="133.0" styleClass="view-input" text="Appointment Date:" />
                  <Label fx:id="AppDate" prefHeight="20.0" prefWidth="284.0" styleClass="view-label">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin></Label>
               </children>
               <padding>
                  <Insets left="30.0" />
               </padding>
            </HBox>
            <HBox alignment="CENTER_LEFT" prefHeight="28.0" prefWidth="430.0" spacing="10.0">
               <children>
                  <Label prefHeight="20.0" prefWidth="135.0" styleClass="view-input" text="Appointment Time:" />
                  <Label fx:id="AppTime" prefHeight="20.0" prefWidth="286.0" styleClass="view-label">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin></Label>
               </children>
               <padding>
                  <Insets left="30.0" />
               </padding>
            </HBox>
            <Button fx:id="backBtn" onAction="#goBack" prefHeight="40.0" prefWidth="95.0" styleClass="signup-button" text="Back" />
         </children>
      </VBox>
   </children>
</AnchorPane>
